# ---- Supabase ----
# Create a project at https://supabase.com and copy from Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# REQUIRED — service role key. Used server-side only (never exposed to the
# browser). The cached read layer uses this with explicit household_id
# filtering; the auth callback uses it to bootstrap household_members rows
# on first signup.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Optional: cron auth ----
# Set if you wire /api/cron/fixed-costs-catchup to a scheduled trigger
# (e.g. Vercel Cron). The route then requires `Authorization: Bearer <secret>`.
# CRON_SECRET=
