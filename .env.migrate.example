# Template for one-off legacy → multi-tenant data migration.
# Copy to `.env.migrate` (which is gitignored) and fill in values, then run:
#   npm run migrate:legacy
#
# See scripts/migrate-from-legacy.ts and the "既存環境からのデータ移行"
# section of README.md for full instructions.

# ---- Source: the old single-tenant Supabase project ----
LEGACY_SUPABASE_URL=https://YOUR-OLD-PROJECT.supabase.co
LEGACY_SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Destination: this multi-tenant Supabase project ----
TARGET_SUPABASE_URL=https://YOUR-NEW-PROJECT.supabase.co
TARGET_SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Destination household_id (must already exist).
# Run on destination DB:  select id, name from households order by created_at;
TARGET_HOUSEHOLD_ID=00000000-0000-0000-0000-000000000000

# Set to "true" to print row counts but skip writes.
DRY_RUN=false
